# Maintainer: Richard Hillmann <richie at project0 dot de>
pkgname=project0-sweet-gtk-themes
pkgver=20260506
pkgrel=1
pkgdesc="Sweet themes"
arch=('any')
url="https://github.com/EliverLara/Sweet.git"
license=('GNU')
conflicts=(
    sweet-gtk-theme
)

sha256sums=('6086e339f4123791df03009e674b4cacf42c6d5a696d0444cac21b5bc1b87f2e'
            '946ccbdb871943af57f18b09c4333b426a85178407ce5af150087bc0ed51f9b2'
            'dc769157b13c647e798d501e7bfa9b7bbe885af0c3c4b38ab84fa6d466b204bc'
            '43e26cec5b37c5503717040567f1a08673f4300bc3c68dcc6c1102d6d445f048'
            '9d1c486e23dcc72313ceff73bebe319b5c095e6f4a141b8b1b347550ea9d1e6a')

_branches=(
    master
    mars
    nova
    Ambar
    Ambar-Blue
)

_kinds=(
    Sweet
    Sweet-mars
    Sweet-nova
    Sweet-Ambar
    Sweet-Ambar-Blue
)
_commits=(
    77a4c3c9dc285bd0efa5ebd59d3372de91c3f274 # master
    b057b217c826caaf9bea20245d8f1a6ae410cab4 # mars
    5ce81a45f0f0b63cf732317e7f91f3467ccce084 # nova
    dd78fc2596e1ba9ab9e3329f205944519f7eca0b # Ambar
    df37b2fcc62f68046468c660699193be37221f50 # Ambar-Blue
)

function srcname () {
    c="${_commits[$1]}"
    k="${_kinds[$1]}"
    echo "git.${pkgname}-${k}-${c}"
}


for i in "${!_kinds[@]}"; do
    c="${_commits[$i]}"
    k="${_kinds[$i]}"
    source+=("$(srcname "$i")::git+${url}#commit=$c")
done

pkgver() {
    (cd "${srcdir}/$(srcname "0")" && git log -1 --format=%ad --date=format:'%Y%m%d')
}

prepare() {
    find "${srcdir}" -type f -name "*scss" -delete
    rm -rf "${srcdir}"/*/{Art,src}
    find "${srcdir}" -type d -empty -delete
}

package() {
    themes="${pkgdir}/usr/share/themes"

    for i in "${!_kinds[@]}"; do
        k="${_kinds[$i]}"
        install -dm755 "${themes}/${k}"
        cp -r "${srcdir}/$(srcname "$i")/"* "${themes}/${k}/"
    done
}
